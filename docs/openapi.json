{
  "components": {
    "schemas": {
      "BookmarkCreate": {
        "description": "Bookmark creation input.",
        "properties": {
          "folder": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Folder"
          },
          "source": {
            "$ref": "#/components/schemas/BookmarkSource",
            "default": "manual"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "url": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "title"
        ],
        "title": "BookmarkCreate",
        "type": "object"
      },
      "BookmarkPage": {
        "description": "Paginated bookmark output.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/BookmarkRead"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "BookmarkPage",
        "type": "object"
      },
      "BookmarkRead": {
        "description": "Bookmark output.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "folder": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Folder"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "source": {
            "$ref": "#/components/schemas/BookmarkSource",
            "default": "manual"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "url": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "title",
          "id",
          "created_at",
          "updated_at"
        ],
        "title": "BookmarkRead",
        "type": "object"
      },
      "BookmarkSource": {
        "description": "Bookmark origin.",
        "enum": [
          "manual",
          "chrome",
          "chromium",
          "edge",
          "firefox"
        ],
        "title": "BookmarkSource",
        "type": "string"
      },
      "BookmarkUpdate": {
        "description": "Partial bookmark update input.",
        "properties": {
          "folder": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Folder"
          },
          "tags": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tags"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "url": {
            "anyOf": [
              {
                "maxLength": 2048,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "title": "BookmarkUpdate",
        "type": "object"
      },
      "Browser": {
        "description": "Supported browser families.",
        "enum": [
          "chrome",
          "chromium",
          "edge",
          "firefox"
        ],
        "title": "Browser",
        "type": "string"
      },
      "ErrorDetail": {
        "description": "API error response.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "description": "API health response.",
        "properties": {
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "ImportResult": {
        "description": "Browser import result.",
        "properties": {
          "browser": {
            "$ref": "#/components/schemas/Browser"
          },
          "discovered": {
            "title": "Discovered",
            "type": "integer"
          },
          "imported": {
            "title": "Imported",
            "type": "integer"
          },
          "profiles": {
            "title": "Profiles",
            "type": "integer"
          },
          "skipped": {
            "title": "Skipped",
            "type": "integer"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/ImportWarning"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "browser",
          "profiles",
          "discovered",
          "imported",
          "skipped"
        ],
        "title": "ImportResult",
        "type": "object"
      },
      "ImportWarning": {
        "description": "One browser import failure that did not stop the full import.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ImportWarningCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "profile": {
            "title": "Profile",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "profile"
        ],
        "title": "ImportWarning",
        "type": "object"
      },
      "ImportWarningCode": {
        "description": "Browser import warning category.",
        "enum": [
          "bookmark_invalid",
          "bookmark_store_failed",
          "profile_invalid",
          "profile_unreadable"
        ],
        "title": "ImportWarningCode",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Link Hoarder API",
