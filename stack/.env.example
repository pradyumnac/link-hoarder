LINK_HOARDER_LOG_LEVEL=INFO
LINK_HOARDER_METADATA_REFRESH_ENABLED=true
LINK_HOARDER_PORT=8080

# Opt in to the local UI A/B test stack. Keep this false for normal use.
LINK_HOARDER_AB_ENABLED=false

# Optional. Omit this value to generate and persist a random API key.
# LINK_HOARDER_API_KEY=replace-with-a-long-random-secret
